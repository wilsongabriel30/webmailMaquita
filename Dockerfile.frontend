# =============================================================================
# Maquita Webmail — Frontend (React 19 + Vite)
# =============================================================================
# Build:  docker build -f Dockerfile.frontend -t maquita-webmail-frontend ./frontend
# =============================================================================

# ---- Stage 1: Build ---------------------------------------------------------
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json package-lock.json ./
RUN npm ci

# Build the production bundle
COPY . .
RUN npm run build

# ---- Stage 2: Serve with nginx ----------------------------------------------
FROM nginx:1.27-alpine

LABEL maintainer="Maquita Webmail Contributors <oss@example.com>"
LABEL description="Maquita Webmail — React frontend served via nginx"
LABEL license="AGPL-3.0-or-later"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Custom nginx config for SPA routing + API proxy
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Non-root: nginx alpine already runs worker as nginx user
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
