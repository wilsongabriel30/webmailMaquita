# =============================================================================
# Maquita Webmail — Backend (FastAPI)
# Build context: repository root (.)
#   docker build -f Dockerfile.backend -t maquita-webmail-backend .
# =============================================================================
FROM python:3.12-slim AS base

LABEL description="Maquita Webmail — FastAPI backend for IMAP/SMTP webmail with compliance features"
LABEL license="AGPL-3.0-or-later"

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev gcc curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --create-home appuser

WORKDIR /app

# Python dependencies (cached layer)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code + helper scripts + migrations
COPY backend/app/ ./app/
COPY scripts/ ./scripts/
COPY migrations/ ./migrations/

RUN mkdir -p /app/.gnupg && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
