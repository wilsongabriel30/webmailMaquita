# =============================================================================
# Maquita Webmail — Environment Variables
# =============================================================================
# Copy this file:  cp .env.example .env
# Then edit .env with your real values. NEVER commit .env to version control.
# Every variable below maps 1:1 to backend/app/config.py (Settings).
# =============================================================================

# -- PostgreSQL ----------------------------------------------------------------
# Connection string used by the backend (host "postgres" = the compose service)
DATABASE_URL=postgresql://mailserver:CHANGE_ME@postgres:5432/maildb
# Individual vars consumed by the postgres container itself:
POSTGRES_USER=mailserver
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=maildb
# POSTGRES_PORT=5432          # optional host port mapping

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# REDIS_PORT=6379

# -- Application secrets -------------------------------------------------------
# Generate each with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets-token-hex-32
ADMIN_JWT_SECRET=generate-another-secret-here

# MASTER_PASSWORD: Dovecot master-user password. The backend logs into any
# mailbox over IMAP using the master user, so this MUST match your Dovecot
# master passdb. Without it, reading mail fails. (See native install guide.)
MASTER_PASSWORD=your-dovecot-master-password

# -- Mail server connections (point these at your Dovecot/Postfix) -------------
# Defaults assume STARTTLS. For implicit TLS use IMAP_PORT=993.
IMAP_HOST=127.0.0.1
IMAP_PORT=143
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SIEVE_HOST=127.0.0.1
SIEVE_PORT=4190

# -- Domain & cookies ----------------------------------------------------------
MAIL_DOMAIN=example.com
COOKIE_DOMAIN=mail.example.com
CORS_ORIGINS=https://mail.example.com

# -- Calendar / Contacts (SOGo DAV, optional) ---------------------------------
SOGO_DAV_URL=http://127.0.0.1:20000/SOGo/dav

# -- AI assistant (optional — Ollama, local inference) -------------------------
# Leave OLLAMA_URL pointing at your Ollama server; IA_API_KEY guards the
# gateway if you front Ollama with one. Both optional; AI features degrade
# gracefully if unset.
OLLAMA_URL=http://127.0.0.1:11434
IA_API_KEY=

# -- GnuPG (PGP / S/MIME key storage) -----------------------------------------
GNUPGHOME=/app/.gnupg

# -- Security audit log --------------------------------------------------------
SECURITY_LOG_PATH=/var/log/webmail/security.log

# -- Optional integrations (Nextcloud / OnlyOffice) ---------------------------
# Only needed if you enable the document/files integration. Safe to leave blank.
# NC_BASE_URL=http://nextcloud-server
# NC_ADMIN_USER=
# NC_ADMIN_PASS=
# NC_PUBLIC_URL=https://your-nextcloud.example.com
# ONLYOFFICE_URL=http://nextcloud-server:8080
# ONLYOFFICE_SECRET=
# ONLYOFFICE_DOWNLOAD_SECRET=

# -- Optional: Docker port overrides ------------------------------------------
# BACKEND_PORT=8000
# FRONTEND_PORT=80
