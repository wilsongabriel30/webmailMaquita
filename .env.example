# =============================================================================
# Maquita Webmail — Environment Variables
# =============================================================================
# Copy this file:  cp .env.example .env
# Then edit .env with your real values. NEVER commit .env to version control.
# =============================================================================

# -- PostgreSQL ----------------------------------------------------------------
# Connection string used by the backend application
DATABASE_URL=postgresql://mailserver:CHANGE_ME@postgres:5432/maildb

# Individual vars used by the postgres Docker container
POSTGRES_USER=mailserver
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=maildb
# POSTGRES_PORT=5432          # host port mapping (default: 5432)

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# REDIS_PORT=6379             # host port mapping (default: 6379)

# -- Application secrets -------------------------------------------------------
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets-token-hex-32

# Separate secret for admin/compliance JWT tokens
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=generate-another-secret-here

# -- Mail server connections ---------------------------------------------------
# These point to your Dovecot/Postfix (or equivalent) mail server.
# In a Docker-only setup you may run these on the host; adjust accordingly.
IMAP_HOST=127.0.0.1
IMAP_PORT=993
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SIEVE_HOST=127.0.0.1
SIEVE_PORT=4190

# -- Domain & cookies ----------------------------------------------------------
# The primary mail domain served by this instance
MAIL_DOMAIN=example.com

# Cookie domain for session cookies (must match your deployment URL)
COOKIE_DOMAIN=mail.example.com

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://mail.example.com

# -- GnuPG --------------------------------------------------------------------
# Directory where the backend stores PGP keyrings (S/MIME & PGP encryption)
GNUPGHOME=/app/.gnupg

# -- Optional: Docker port overrides ------------------------------------------
# BACKEND_PORT=8000
# FRONTEND_PORT=80
