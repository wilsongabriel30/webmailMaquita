# Configuración del servicio de chat. Copiar a `.env` (permisos 600) y rellenar.
# Ningún valor de ejemplo sirve en producción: todos los secretos se generan con
# `openssl rand -hex 32` y son DISTINTOS entre sí.

# --- Bases de datos -----------------------------------------------------------------
# Base del chat (conversaciones y mensajes).
DATABASE_URL=postgresql://USUARIO@SERVIDOR:5432/BASE_DEL_CHAT
# Directorio de personas. Es la tabla `usuarios` de la plataforma: el chat NO tiene lista
# propia, reconoce a cada quien por el CORREO de esa tabla.
USERS_DB_URL=postgresql://USUARIO@SERVIDOR:5432/BASE_DE_USUARIOS
USE_PGBOUNCER=0

# --- Identidad ----------------------------------------------------------------------
# Clave con la que la plataforma firma la sesión que el chat acepta por cookie.
CHAT_JWT_SECRET=
# Secreto DEDICADO de la puerta de entrada (`/sso/entrar`). No es el del correo ni el de
# la sesión del chat: con él, otro sistema de confianza emite un vale de un solo uso.
CHAT_SSO_SECRET=
# Clave de la sesión propia del chat (cookie `chat_session`).
CHAT_SESSION_KEY=
# Secreto compartido entre servicios (avisos y revocación de sesiones).
NOTIF_SECRET=
# Dominios cuyos buzones son la misma persona (misma parte local).
DOMINIOS_EQUIVALENTES=ejemplo.org,ejemplo.com

# --- Sesión central (F-03) ----------------------------------------------------------
# El chat comprueba contra el correo la sesión que este emitió. Ponerlo a 0 solo durante
# una actualización, nunca de forma permanente.
CHAT_SESION_CENTRAL=1
CHAT_REVALIDAR_SESION_SEG=300
# Tope de las sesiones abiertas por OTRO sistema de confianza (no hay sesión del correo a
# la que preguntar): al vencer, se vuelve a entrar por la puerta, sin que se note.
CHAT_SESION_EXTERNA_MAX_SEG=43200
# A quién pregunta el chat por la sesión del correo.
CORREO_URL_API=https://correo.ejemplo.org

# --- Red ------------------------------------------------------------------------------
CHAT_PORT=8790
CHAT_URL_PUBLICA=https://mensajeria.ejemplo.org
CHAT_CORS_ORIGENES=https://correo.ejemplo.org,https://plataforma.ejemplo.org
CHAT_REDIS_URL=redis://127.0.0.1:6379/3

# --- Opcionales -------------------------------------------------------------------------
# Lista de personas desde nómina (si no se usa, dejar en blanco: el buscador funciona igual).
NOMINA_DB_HOST=
NOMINA_DB_PORT=5432
NOMINA_DB_NAME=
NOMINA_DB_USER=
NOMINA_DB_PASSWORD=
# Almacén de archivos (adjuntos que van al Drive).
ALMACEN_URL=
ALMACEN_SECRETO_INTERNO=
# Llamadas y reuniones.
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TURN_SECRET=
LIVEKIT_TURN_UDP_HOST=
LIVEKIT_TURN_TLS_HOST=
JITSI_URL=
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
# Biblioteca de GIF (si se deja en blanco, esa pestaña no aparece).
GIPHY_API_KEY=
# Calendario del correo (invitaciones de reuniones).
CORREO_URL_CALENDARIO=
