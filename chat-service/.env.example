# --- Servicio de Chat Maquita ---
# Base de datos (PostgreSQL propio del chat)
CHAT_DB_HOST=chat-db
CHAT_DB_NAME=chat
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=cambiar

# Tiempo real
CHAT_REDIS_URL=redis://chat-redis:6379/0
CHAT_PORT=8790

# Autenticacion: JWT compartido con el cliente (el correo). En produccion, Keycloak.
CHAT_JWT_SECRET=cambiar-por-el-secret-del-correo

# Video grupal (LiveKit) — opcional. Sin esto, el chat funciona sin videollamadas grupales.
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- GIF de fuentes externas (opcional; por defecto DESACTIVADO) ---
# La biblioteca de GIF propia funciona sin nada de esto. Si se activa una fuente,
# el texto que la gente escribe en el buscador sale a ese tercero.
#GIPHY_API_KEY=            # clave propia de GIPHY; sin ella no se consulta
#GIFS_EXTERNOS_COMMONS=0   # 1 para permitir Wikimedia Commons
