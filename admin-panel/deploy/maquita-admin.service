[Unit]
Description=Maquita Mail Admin Panel
After=network.target postgresql.service dovecot.service postfix.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/maquita-webmail/admin-panel/backend
# Gunicorn gestiona uvicorn workers y los RECICLA cada ~800 req (jitter 200)
# para acotar la fuga de memoria: el worker se reinicia uno a la vez (sin downtime)
# y libera la memoria filtrada ANTES de acercarse al limite. Evita el cuelgue/502.
ExecStart=/opt/maquita-webmail/admin-panel/backend/venv/bin/gunicorn app.main:app --workers 6 --worker-class uvicorn.workers.UvicornWorker --bind 127.0.0.1:8001 --max-requests 800 --max-requests-jitter 200 --timeout 120 --graceful-timeout 30 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/maquita-webmail/admin-panel/backend/.env

[Install]
WantedBy=multi-user.target
