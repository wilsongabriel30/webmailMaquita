#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
"""maquita-sudo — la ÚNICA orden que www-data y maquita-admin pueden ejecutar con sudo.

Séptima revisión (Qwen, 2026-09-07): en sudoers, `doveadm search -u *` admite cualquier
argumento después de `-u`, no solo el buzón (`-o`, `-c`, otro subcomando...), y el código que
llamaba no validaba el buzón antes del sudo. Lo mismo valía para los comodines del panel.

Aquí no hay comodines: sudoers concede SOLO este programa, y este programa decide, orden por
orden y argumento por argumento, qué deja pasar. Corre como root y es el último sitio donde se
puede comprobar, así que no se fía de quien llama aunque ya valide por su lado.

Uso:  maquita-sudo <programa> [argumentos...]
      programa ∈ doveadm, postqueue, postsuper, postconf, systemctl, journalctl, sievec,
                 fail2ban-client, nginx, sendmail, maquita-outbound,
                 depurar-adjuntos-peligrosos, geoip-country.sh, maquita-sitios,
                 maquita-dns, maquita-cortafuegos,
                 maquita-identidad, maquita-fts, maquita-wazuh
La política depende de quién llama (SUDO_USER): www-data solo puede lo que necesita el correo
(recuperar mensajes y ver/gestionar la cola); maquita-admin, lo que necesita el panel.
Todo se registra en syslog (auth) con la marca MAQUITA_SUDO; las contraseñas se enmascaran.

Los validadores de cada programa están en módulos aparte (deploy/sudoers/lib/, instalados en
/usr/local/lib/maquita-sudo/ por deploy/sudoers/instalar.sh): aquí quedan la política, la autorización y la
ejecución. Instalado, solo se cargan de esa carpeta y si ni ella ni sus archivos los puede escribir nadie más
que root; si no, no pasa ninguna orden. «-I» en la primera línea: Python no mira PYTHONPATH ni la carpeta actual.
"""
import logging
import logging.handlers
import os
import re
import shutil
import sys

LIB_INSTALADA = "/usr/local/lib/maquita-sudo"


def _carpeta_lib():
    """La carpeta de los validadores: la fija si está instalado en /usr/local/sbin; si no (repositorio y pruebas),
    deploy/sudoers/lib junto a este archivo."""
    aqui = os.path.dirname(os.path.realpath(__file__))
    return LIB_INSTALADA if aqui == "/usr/local/sbin" else os.path.join(aqui, "lib")


def _solo_root(carpeta):
    """La carpeta y sus .py son de root y nadie más puede escribirlos (si no, alguien podría cambiar las reglas)."""
    rutas = [carpeta] + [os.path.join(carpeta, n) for n in os.listdir(carpeta) if n.endswith(".py")]
    for ruta in rutas:
        st = os.lstat(ruta)
        if st.st_uid != 0 or st.st_mode & 0o022 or os.path.islink(ruta):
            return False
    return True


LIB = _carpeta_lib()
if LIB == LIB_INSTALADA and not (os.path.isdir(LIB) and _solo_root(LIB)):
    print(f"maquita-sudo: {LIB} falta o la puede escribir otro usuario que root: no pasa ninguna orden", file=sys.stderr)
    sys.exit(3)
if LIB not in sys.path:
    sys.path.insert(0, LIB)

from sudo_base import Rechazo, _buzon_existe, _tokens_limpios, es_buzon  # noqa: E402,F401
from sudo_correo import (validar_depurar, validar_doveadm, validar_fail2ban, validar_geoip,  # noqa: E402
                         validar_journalctl, validar_nginx, validar_outbound, validar_postconf, validar_postqueue,
                         validar_postsuper, validar_sendmail, validar_sievec, validar_systemctl)
