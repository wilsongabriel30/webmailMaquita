VALIDADORES = {
    "doveadm": validar_doveadm, "postqueue": validar_postqueue, "postsuper": validar_postsuper,
    "postconf": validar_postconf, "systemctl": validar_systemctl, "journalctl": validar_journalctl,
    "sievec": validar_sievec, "fail2ban-client": validar_fail2ban, "nginx": validar_nginx,
    "sendmail": validar_sendmail, "maquita-outbound": validar_outbound,
    "depurar-adjuntos-peligrosos": validar_depurar, "geoip-country.sh": validar_geoip,
    "maquita-sitios": validar_sitios,
    "maquita-dns": validar_dns,
    "maquita-cortafuegos": validar_cortafuegos,
