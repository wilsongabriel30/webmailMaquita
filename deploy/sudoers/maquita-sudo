_RE_REF_VERSION = re.compile(r"^(?:v\d{1,4}\.\d{1,4}\.\d{1,4}|origin/[A-Za-z0-9][A-Za-z0-9._/-]{0,99})$")


def validar_actualizar(args):
    """maquita-actualizar: lo que usa el panel; «ejecutar» y «automatico» son del sistema."""
