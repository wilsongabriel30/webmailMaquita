# Programas propios: se ejecutan SOLO desde su ruta fija; si no están, no se buscan en el PATH.
SOLO_RUTA_FIJA = {"maquita-outbound", "depurar-adjuntos-peligrosos", "geoip-country.sh", "maquita-sitios", "maquita-dns", "maquita-cortafuegos", "maquita-identidad", "maquita-actualizar", "maquita-respaldos", "maquita-fts", "maquita-wazuh"}

# Qué puede cada usuario llamante. True = todos los subcomandos que valida este programa.
