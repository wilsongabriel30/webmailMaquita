def validar_sitios(args):
    """maquita-sitios: cada subacción con la forma exacta de sus argumentos (el ayudante revalida)."""
    dom = lambda d: bool(_RE_DOMINIO_SITIO.match(d))  # noqa: E731
    if args in (["estado"], ["listar"], ["catalogo"]):
        return args
