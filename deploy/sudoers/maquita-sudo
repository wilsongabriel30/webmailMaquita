_MODOS_ARCHIVO = ("644", "755", "600", "700", "640", "750")


def _validar_sitios_datos(args, dom):
    ruta = lambda a: bool(_RE_B64URL_LARGO.match(a))  # noqa: E731
    if len(args) < 2 or not dom(args[1]):
        return False
    orden, n = args[0], len(args)
    if orden in _ORDENES_DATOS_SOLO_DOMINIO:
        return n == 2
    if orden == "registros":
        return (n in (4, 5) and args[2] in ("error", "acceso", "php") and re.fullmatch(r"[1-9][0-9]{0,3}", args[3])
                and int(args[3]) <= 1000 and (n == 4 or bool(_RE_B64URL.match(args[4]))))
    if orden in ("copia-descargar", "copia-restaurar", "copia-borrar"):
        return n == 3 and bool(_RE_COPIA_SITIO.match(args[2]))
    if orden in ("archivos-listar", "archivos-descargar", "archivos-carpeta", "archivos-borrar"):
        return n == 3 and ruta(args[2])
    if orden == "archivos-subir":
        return (n in (4, 5) and ruta(args[2]) and bool(re.fullmatch(r"[0-9a-f]{32}\.subida", args[3]))
                and (n == 4 or args[4] == "reemplazar"))
    if orden in ("archivos-mover", "archivos-copiar", "archivos-descomprimir"):
        return n == 4 and ruta(args[2]) and ruta(args[3])
    if orden == "archivos-comprimir":
        return n == 3 and bool(_RE_B64URL_MUY_LARGO.match(args[2]))
    if orden == "archivos-permisos":
        return n == 4 and ruta(args[2]) and args[3] in _MODOS_ARCHIVO
    if orden == "archivos-recuperar":
        return n == 3 and bool(re.fullmatch(r"[0-9a-f]{12}", args[2]))
    return False


_RE_B64URL_LARGO = re.compile(r"^[A-Za-z0-9_-]{1,8000}$")
_RE_B64URL_MUY_LARGO = re.compile(r"^[A-Za-z0-9_-]{1,40000}$")
_RE_ID_REGISTRO = re.compile(r"^[0-9a-f]{8}$")


# --- maquita-sitios: funciones web por sitio y cuentas FTP adicionales (v1.10) ---
# Bloque aparte de validar_sitios para que otras secciones se fusionen sin tocarlo. Los datos libres (listas,
# carpetas, contraseñas) viajan en base64url y el ayudante los vuelve a validar uno a uno.
_ORDENES_SITIOS_WEB_JSON = ("web-redirecciones", "web-errores", "web-hotlink", "web-bloqueo", "web-optimizacion")
_ORDENES_SITIOS_WEB = {"web", "web-purgar", "web-privado-agregar", "web-privado-quitar", "ftp-cuentas",
                       "ftp-cuenta-crear", "ftp-cuenta-clave", "ftp-cuenta-quitar", *_ORDENES_SITIOS_WEB_JSON}
_RE_B64URL_LISTA = re.compile(r"^[A-Za-z0-9_-]{1,20000}$")  # hasta 200 redirecciones o 500 IP
_RE_USUARIO_CARPETA = re.compile(r"^[A-Za-z0-9._-]{1,32}$")
_RE_CUENTA_FTP = re.compile(r"^[a-z][a-z0-9]{1,10}$")


def validar_sitios_web(args):
    """maquita-sitios web…/ftp-…: forma exacta de cada argumento (ver deploy/sitios/lib/funciones_web.py)."""
    dom = lambda d: bool(_RE_DOMINIO_SITIO.match(d))  # noqa: E731
    b64 = lambda a: bool(_RE_B64URL.match(a))  # noqa: E731  carpeta, subcarpeta o contraseña (≤ 200)
    if len(args) == 2 and args[0] in ("web", "web-purgar", "ftp-cuentas") and dom(args[1]):
        return args
    if len(args) == 3 and args[0] in ("web-redirecciones", "web-bloqueo") and dom(args[1]) and _RE_B64URL_LISTA.match(args[2]):
        return args
    if len(args) == 3 and args[0] in ("web-errores", "web-hotlink", "web-optimizacion") and dom(args[1]) \
            and _RE_B64URL_LARGO.match(args[2]):
        return args
    if (len(args) in (4, 5) and args[0] == "web-privado-agregar" and dom(args[1]) and b64(args[2])
            and _RE_USUARIO_CARPETA.match(args[3]) and (len(args) == 4 or b64(args[4]))):
        return args
    if (len(args) in (3, 4) and args[0] == "web-privado-quitar" and dom(args[1]) and b64(args[2])
            and (len(args) == 3 or _RE_USUARIO_CARPETA.match(args[3]))):
        return args
    if len(args) == 4 and args[0] == "ftp-cuenta-crear" and dom(args[1]) and _RE_CUENTA_FTP.match(args[2]) and b64(args[3]):
        return args
    if len(args) == 3 and args[0] in ("ftp-cuenta-clave", "ftp-cuenta-quitar") and dom(args[1]) and _RE_CUENTA_FTP.match(args[2]):
        return args
    raise Rechazo("maquita-sitios: subacción o argumentos no permitidos")


def validar_dns(args):
    """maquita-dns: subacciones con su forma exacta; los datos libres van en base64url (el ayudante revalida)."""
    zona = lambda z: bool(_RE_DOMINIO_SITIO.match(z))  # noqa: E731
    b64 = lambda v: bool(_RE_B64URL_LARGO.match(v))  # noqa: E731
    if args in (["estado"], ["servidor-ver"], ["listar"], ["certificado-estado"], ["certificado-correo"]):
        return args
    if len(args) == 2 and args[0] == "servidor" and b64(args[1]):
        return args
    if len(args) == 2 and args[0] in ("ver", "comprobar") and zona(args[1]):
        return args
    if args[:1] == ["crear"] and len(args) in (2, 3) and zona(args[1]) and (len(args) == 2 or args[2] == "sin-web"):
        return args
    if len(args) == 3 and args[0] == "agregar" and zona(args[1]) and b64(args[2]):
        return args
    if len(args) == 4 and args[0] == "modificar" and zona(args[1]) and _RE_ID_REGISTRO.match(args[2]) and b64(args[3]):
        return args
    if len(args) == 3 and args[0] == "borrar-registro" and zona(args[1]) and _RE_ID_REGISTRO.match(args[2]):
        return args
    if len(args) == 3 and args[0] == "borrar" and zona(args[1]) and args[1] == args[2]:
        return args
    raise Rechazo("maquita-dns: subacción o argumentos no permitidos")


_RE_IP_O_RED = re.compile(r"^[0-9a-fA-F:.]{2,45}(?:/\d{1,3})?$")


