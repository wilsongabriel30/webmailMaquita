def autorizar(usuario: str, programa: str, args, comprobar_buzon=_buzon_existe):
    """Devuelve los argumentos validados o lanza Rechazo. Sin efectos."""
    permisos = POLITICA.get(usuario)
    if not permisos or programa not in permisos:
        raise Rechazo(f"{usuario} no puede ejecutar {programa}")
    if programa == "maquita-outbound":
        # Sus listas de buzones pueden pasar de 300 caracteres: se validan elemento a elemento.
        if any(not isinstance(a, str) or not a or len(a) > 12000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return validar_outbound(list(args))
    # Datos en base64url de más de 300 caracteres (la lista de alias, 10 dominios, también los pasa).
    if programa == "maquita-sitios" and args[:1] in (["inicio"], ["propia-crear"], ["propia-entorno"], ["git-configurar"],
                                                     ["alias"]):
        if any(not isinstance(a, str) or not a or len(a) > 8000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return validar_sitios(list(args))
    if programa == "maquita-sitios" and args[:1] and args[0] in _ORDENES_SITIOS_WEB_JSON:
        # Listas de redirecciones o de IP: pasan de 300 caracteres; se validan enteras en validar_sitios_web.
        if any(not isinstance(a, str) or not a or len(a) > 20000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return validar_sitios(list(args))
    if programa == "maquita-sitios" and args[:1] and args[0] in _ORDENES_DESARROLLO_LARGAS:
        if any(not isinstance(a, str) or not a or len(a) > 8000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return validar_sitios(list(args))
    if programa == "maquita-sitios" and args[:1] and str(args[0]).startswith("archivos-"):
        # Rutas largas en base64url (hasta 40 000 caracteres la lista de «comprimir»).
        if any(not isinstance(a, str) or not a or len(a) > 40000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return validar_sitios(list(args))
    if programa in ("maquita-cortafuegos", "maquita-identidad", "maquita-respaldos"):
        if any(not isinstance(a, str) or not a or len(a) > 8000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return VALIDADORES[programa](list(args))
    if programa == "maquita-dns":
        # Registros como DKIM superan los 300 caracteres: base64url validado elemento a elemento.
        if any(not isinstance(a, str) or not a or len(a) > 8000 or re.search(r"[\x00-\x1f\x7f]", a) for a in args):
            raise Rechazo("argumento con caracteres de control o vacío")
        return validar_dns(list(args))
    _tokens_limpios(args)
    if programa == "maquita-fts":
        return validar_fts(list(args), comprobar_buzon)
    if programa == "doveadm":
        salida = validar_doveadm(list(args), comprobar_buzon)
        if permisos["doveadm"] is not True and salida[0] not in permisos["doveadm"]:
            raise Rechazo(f"{usuario} no puede ejecutar doveadm {salida[0]}")
        return salida
    return VALIDADORES[programa](list(args))


def _enmascarar(programa, args):
    out = []
    ocultar = False
    for i, a in enumerate(args):
        if ocultar:
            out.append("***")
            ocultar = False
            continue
        out.append(a)
        if programa == "doveadm" and a == "-p":
            ocultar = True
        if programa == "doveadm" and args[:2] == ["auth", "test"] and i == 3:
            out[-1] = "***"
        if programa == "maquita-respaldos" and args[:1] == ["credenciales"] and i == 1:
            out[-1] = "***"  # credenciales del destino externo
        if programa == "maquita-sitios" and args[:1] == ["propia-entorno"] and i == 2:
            out[-1] = "***"  # valores de las variables de entorno (claves de API, contraseñas)
        if programa == "maquita-sitios" and args[:1] == ["web-privado-agregar"] and i == 4:
            out[-1] = "***"  # contraseña elegida para una carpeta privada
    return " ".join(out)


def main(argv):
    log = logging.getLogger("maquita-sudo")
    try:
        h = logging.handlers.SysLogHandler(address="/dev/log", facility=logging.handlers.SysLogHandler.LOG_AUTH)
        h.setFormatter(logging.Formatter("maquita-sudo: %(message)s"))
        log.addHandler(h)
    except Exception:
        log.addHandler(logging.StreamHandler(sys.stderr))
    log.setLevel(logging.INFO)
    usuario = os.environ.get("SUDO_USER", "")
    if len(argv) < 2:
        print("uso: maquita-sudo <programa> [args]", file=sys.stderr)
        return 2
    programa, args = argv[1], argv[2:]
    if programa not in BINARIOS:
        log.warning("MAQUITA_SUDO rechazado usuario=%s programa=%s motivo=programa desconocido", usuario, programa)
        return 3
    try:
        validados = autorizar(usuario, programa, args)
    except Rechazo as r:
        log.warning("MAQUITA_SUDO rechazado usuario=%s programa=%s motivo=%s args=%s",
                    usuario, programa, r, _enmascarar(programa, args)[:500])
        print(f"maquita-sudo: rechazado: {r}", file=sys.stderr)
        return 3
    binario = BINARIOS[programa]
    if not os.path.isfile(binario):
        if programa in SOLO_RUTA_FIJA:
            log.warning("MAQUITA_SUDO rechazado usuario=%s programa=%s motivo=no instalado", usuario, programa)
            print(f"maquita-sudo: {programa} no está instalado en {binario}", file=sys.stderr)
            return 3
        binario = shutil.which(programa) or binario
    log.info("MAQUITA_SUDO ok usuario=%s %s %s", usuario, programa, _enmascarar(programa, validados)[:500])
    os.environ.clear()
    os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    os.environ["LANG"] = "C.UTF-8"
    os.execv(binario, [binario] + validados)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
