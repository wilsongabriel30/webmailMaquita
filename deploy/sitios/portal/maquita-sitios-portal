#!/usr/bin/env python3
"""maquita-sitios-portal — intermediario entre el portal de dominio y maquita-sitios / maquita-dns.

El portal (usuario maquita-dominio) no tiene sudo ni debe tenerlo. Para sus sitios web habla con este
programa por /run/maquita-sitios-portal.sock: systemd acepta cada conexión y arranca una instancia como
root (maquita-sitios-portal@.service) con el socket como entrada y salida.

No se fía del portal. En cada petición:
  1. el que llama tiene que ser maquita-dominio (o root), según el núcleo (SO_PEERCRED);
  2. la ficha de sesión se vuelve a comprobar en la base, con los dominios asignados de ese momento;
  3. solo se aceptan las órdenes de la lista (lib/portal.py), sobre sitios de sus dominios;
  4. los argumentos que salen pasan además por el validador de maquita-sudo antes de ejecutar.

Protocolo: UNA línea JSON de ida y UNA de vuelta (máx. 64 KB).
  → {"ficha": "...", "orden": "...", "dominio": "...", "args": {...}}
  ← {"ok": true, "datos": ...}  |  {"ok": false, "codigo": 400|403|404|409|413|503, "error": "..."}
"""

import os
import sys

sys.path.insert(0, "/usr/local/lib/maquita-sitios-portal")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import ayudantes  # noqa: E402
import conexion  # noqa: E402
from errores import ErrorPortal  # noqa: E402


def main():
    entrada, salida = sys.stdin.buffer, sys.stdout.buffer
    os.umask(0o022)
    try:
        uid = conexion.usuario_del_par(0)
    except OSError:
        uid = None
    if uid is None or not conexion.par_autorizado(uid):
        ayudantes.registro().warning("MAQUITA_SITIOS_PORTAL rechazado uid=%s motivo=quien llama no es el portal", uid)
        conexion.responder(salida, conexion.error(ErrorPortal(403, "No autorizado")))
        return 1
    import portal

    peticion = {}
    try:
        peticion = conexion.leer_peticion(entrada)
        respuesta = portal.atender(peticion)
    except ErrorPortal as e:
        ayudantes.registro().warning("MAQUITA_SITIOS_PORTAL rechazado orden=%s dominio=%s codigo=%s motivo=%s",
                                     str(peticion.get("orden"))[:40], str(peticion.get("dominio"))[:200],
                                     e.codigo, e.texto[:200])
        respuesta = conexion.error(e)
    except Exception as e:  # sin traza hacia el portal; sí en el registro
        ayudantes.registro().error("MAQUITA_SITIOS_PORTAL fallo %s: %s", type(e).__name__, str(e)[:300])
        respuesta = conexion.error(ErrorPortal(503, "Fallo interno del intermediario de sitios (ver registro del sistema)"))
    try:
        conexion.responder(salida, respuesta)
    except OSError:
        return 1  # el portal cerró la conexión antes de tiempo
    return 0 if respuesta.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
