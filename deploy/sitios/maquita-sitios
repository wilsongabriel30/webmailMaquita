#!/usr/bin/env python3
"""maquita-sitios — sitios web del servidor (sección «Sitios web» del panel de administración).

Corre como root y solo se llama desde el panel a través de maquita-sudo. Responde siempre JSON.

Uso:
  maquita-sitios estado
  maquita-sitios listar
  maquita-sitios crear <dominio> [con-www|sin-www] [nombre de la institución en base64url]
  maquita-sitios app <dominio> <wordpress|joomla> <título en base64url> <correo del administrador>
  maquita-sitios ftp <dominio> <activar|desactivar>
  maquita-sitios ssl <dominio> <correo para Let's Encrypt>
  maquita-sitios borrar <dominio> <dominio repetido como confirmación>
  maquita-sitios inicio <dominio> <identidad en JSON base64url>   rehace la página «en construcción»
  maquita-sitios buscadores <dominio>     visibilidad en buscadores e IA (robots, mapa, llms.txt, schema.org…)
  maquita-sitios avisar <dominio>         avisa por IndexNow de la portada y el mapa del sitio
  maquita-sitios tienda <dominio>         WooCommerce en un sitio con WordPress
  maquita-sitios bases <dominio>          bases de datos adicionales del sitio
  maquita-sitios base-crear <dominio> <mariadb|postgresql>
  maquita-sitios base-borrar <dominio> <nombre>   (la copia .sql queda en la carpeta privada del sitio)
  maquita-sitios entrar <dominio>         enlace de un solo uso al escritorio de WordPress
  maquita-sitios clave-admin <dominio>    contraseña nueva del administrador de la aplicación
  maquita-sitios revisar <dominio>        versión, actualizaciones pendientes e integridad
  maquita-sitios actualizar <dominio>     actualiza núcleo, complementos, temas e idioma
Solo desde el sistema (no las admite maquita-sudo):
  maquita-sitios cron                     tareas programadas de las aplicaciones (systemd)
  maquita-sitios regenerar                reescribe los vhosts con las plantillas vigentes
"""

import json
import os
import shutil
import sys

sys.path.insert(0, "/usr/local/lib/maquita-sitios")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import validacion as v  # noqa: E402
from comun import WP_CLI, ErrorSitio, version_php  # noqa: E402


def estado():
    return {
        "php": version_php(),
        "mariadb": bool(shutil.which("mariadb")),
        "wp_cli": os.path.exists(WP_CLI),
        "ftp": bool(shutil.which("vsftpd")),
        "certbot": bool(shutil.which("certbot")),
        "aplicaciones": list(v.APLICACIONES),
    }


def despachar(args):
    import acceso
    import aplicaciones
    import sitio

    if args == ["estado"]:
        return estado()
    if args == ["listar"]:
        return {"sitios": sitio.listar(), "estado": estado()}
    if 2 <= len(args) <= 4 and args[0] == "crear":
        if len(args) >= 3 and args[2] not in ("con-www", "sin-www"):
            raise ErrorSitio("crear: tercer argumento no permitido")
        nombre = v.titulo(args[3]) if len(args) == 4 else None
        return sitio.crear(v.dominio(args[1]), con_www=len(args) == 2 or args[2] == "con-www", nombre=nombre)
    if len(args) == 5 and args[0] == "app":
        return aplicaciones.instalar(v.dominio(args[1]), v.aplicacion(args[2]), v.titulo(args[3]), v.correo(args[4]))
    if len(args) == 3 and args[0] == "ftp" and args[2] in ("activar", "desactivar"):
        return acceso.ftp(v.dominio(args[1]), args[2])
    if len(args) == 3 and args[0] == "ssl":
        return acceso.ssl(v.dominio(args[1]), v.correo(args[2]))
    if len(args) == 3 and args[0] == "borrar":
        if args[1] != args[2]:
            raise ErrorSitio("borrar: la confirmación no coincide con el dominio")
        return sitio.borrar(v.dominio(args[1]))
    if len(args) == 2 and args[0] in ("buscadores", "avisar"):
        import visibilidad

        return (visibilidad.revisar if args[0] == "buscadores" else visibilidad.avisar)(v.dominio(args[1]))
    if len(args) == 2 and args[0] in ("entrar", "clave-admin", "revisar", "actualizar"):
        import seguridad

        funcion = {"entrar": seguridad.entrar, "clave-admin": seguridad.clave_admin,
                   "revisar": seguridad.revisar, "actualizar": seguridad.actualizar}[args[0]]
        return funcion(v.dominio(args[1]))
    if len(args) == 3 and args[0] == "inicio":
        import json as _json

        from comun import de_base64

        try:
            identidad = _json.loads(de_base64(args[2]))
        except ValueError:
            raise ErrorSitio("identidad no válida")
        if not isinstance(identidad, dict):
            raise ErrorSitio("identidad no válida")
        limpia = {k: str(identidad[k])[:400] for k in ("nombre", "descripcion", "correo", "telefono", "color")
                  if identidad.get(k)}
        if isinstance(identidad.get("redes"), dict):
            limpia["redes"] = {str(k)[:20]: str(u)[:200] for k, u in identidad["redes"].items()}
        return sitio.rehacer_inicio(v.dominio(args[1]), limpia)
    if len(args) == 2 and args[0] == "tienda":
        import seguridad

        return seguridad.tienda(v.dominio(args[1]))
    if len(args) == 2 and args[0] == "bases":
        import bases

        return bases.listar(v.dominio(args[1]))
    if len(args) == 3 and args[0] == "base-crear" and args[2] in ("mariadb", "postgresql"):
        import bases

        return bases.crear(v.dominio(args[1]), args[2])
    if len(args) == 3 and args[0] == "base-borrar":
        import bases

        return bases.borrar(v.dominio(args[1]), args[2])
    if args == ["cron"]:
        import seguridad

        return seguridad.cron()
    if args == ["regenerar"]:
        return sitio.regenerar()
    raise ErrorSitio("orden o argumentos no permitidos")


def main(argv):
    if os.geteuid() != 0:
        print(json.dumps({"error": "maquita-sitios debe ejecutarse como root"}))
        return 1
    os.umask(0o022)
    try:
        resultado = despachar(argv[1:])
    except ErrorSitio as e:
        print(json.dumps({"error": str(e)}, ensure_ascii=False))
        return 1
    except Exception as e:  # cualquier otro fallo: sin traza hacia el panel, sí en stderr
        print(f"maquita-sitios: {type(e).__name__}: {e}", file=sys.stderr)
        print(json.dumps({"error": "fallo interno del ayudante de sitios (ver registro del sistema)"}))
        return 1
    print(json.dumps(resultado, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
