#!/usr/bin/env python3
"""Genera la libreta de la organización que Z-Push muestra en los teléfonos y en Outlook.

Escribe /var/lib/z-push/directorio/<dominio>.json con los buzones activos de cada dominio (solo
nombre y correo: ni teléfonos ni correos alternativos). Lo lee BackendSearchMaquita dentro del
contenedor. Se ejecuta cada 15 minutos (maquita-zpush-directorio.timer) y tras instalar.

Uso: maquita-zpush-directorio [--simular]
"""
import json
import os
import re
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlsplit

APP_DIR = os.environ.get("MAQUITA_APP_DIR", "/opt/maquita-webmail")
CARPETA = os.environ.get("ZPUSH_DIRECTORIO", "/var/lib/z-push/directorio")
GID_WWW = 33  # www-data dentro del contenedor
RE_DOMINIO = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+")
# Direcciones de sistema que nadie escribe a mano.
RE_SISTEMA = re.compile(r"(no-?reply|no-?responder|mailer-daemon|postmaster|abuse|dmarc|bounces?)(\+.*)?@.*")


def url_base():
    with open(os.path.join(APP_DIR, "backend/.env"), encoding="utf-8") as f:
        for linea in f:
            if linea.startswith("DATABASE_URL="):
                return linea.split("=", 1)[1].strip().strip('"')
    raise SystemExit("No hay DATABASE_URL en backend/.env")


def buzones():
    url = urlsplit(url_base().replace("postgresql+asyncpg://", "postgresql://"))
    entorno = dict(os.environ, PGPASSWORD=unquote(url.password or ""), PGHOST=url.hostname or "localhost",
                   PGPORT=str(url.port or 5432), PGUSER=unquote(url.username or ""), PGDATABASE=url.path.lstrip("/"))
    consulta = ("SELECT json_agg(json_build_array(lower(username), name, lower(domain)) ORDER BY name, username) "
                "FROM mailbox WHERE active")
    salida = subprocess.run(["psql", "-X", "-qtA", "-c", consulta], env=entorno, capture_output=True, text=True,
                            check=True).stdout.strip()
    return json.loads(salida or "null") or []


def partir(nombre):
    partes = nombre.split()
    if len(partes) >= 4:
        return " ".join(partes[:2]), " ".join(partes[2:])
    if len(partes) >= 2:
        return partes[0], " ".join(partes[1:])
    return "", ""


def directorios(filas):
    por_dominio = {}
    for correo, nombre, dominio in filas:
        if not dominio or not RE_DOMINIO.fullmatch(dominio) or RE_SISTEMA.fullmatch(correo):
            continue
        nombre = (nombre or "").strip()
        if nombre.lower() == correo.split("@")[0]:
            nombre = ""  # «info» como nombre no ayuda: se muestra el correo
        nombres, apellidos = partir(nombre)
        por_dominio.setdefault(dominio, []).append(
            {"correo": correo, "nombre": nombre, "nombres": nombres, "apellidos": apellidos})
    return por_dominio


def escribir(ruta, datos):
    contenido = json.dumps(datos, ensure_ascii=False, indent=1)
    try:
        with open(ruta, encoding="utf-8") as f:
            if f.read() == contenido:
                return False
    except FileNotFoundError:
        pass
    fd, tmp = tempfile.mkstemp(dir=CARPETA, prefix=".dir-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(contenido)
    os.chown(tmp, 0, GID_WWW)
    os.chmod(tmp, 0o640)
    os.replace(tmp, ruta)
    return True


def main():
    simular = "--simular" in sys.argv[1:]
    por_dominio = directorios(buzones())
    if simular:
        for dominio, lista in sorted(por_dominio.items()):
            print(f"{dominio}: {len(lista)} personas")
        return
    os.makedirs(CARPETA, mode=0o750, exist_ok=True)
    os.chown(CARPETA, 0, GID_WWW)
    os.chmod(CARPETA, 0o750)
    cambios = sum(escribir(os.path.join(CARPETA, f"{d}.json"), lista) for d, lista in por_dominio.items())
    for viejo in os.listdir(CARPETA):  # dominios dados de baja
        if viejo.endswith(".json") and viejo[:-5] not in por_dominio:
            os.unlink(os.path.join(CARPETA, viejo))
            cambios += 1
    print(f"Libreta de la organización: {len(por_dominio)} dominios, {cambios} cambios.")


if __name__ == "__main__":
    main()
