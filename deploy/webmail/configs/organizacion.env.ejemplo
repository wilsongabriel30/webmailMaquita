# Datos de la organización que instala el correo.
# Copiar a /etc/maquita-mail/organizacion.env (permisos 644: no lleva secretos) y rellenar.
# Lo leen el correo, el panel, el filtro y los guiones de vigilancia. También lo puede leer un
# guion de shell, así que los valores con espacios van entre comillas.
# Lo que se deje sin definir toma un valor de ejemplo que NO funciona en producción.

# --- Dominios -------------------------------------------------------------------------------
# Dominio principal (si el servicio ya define MAIL_DOMAIN en su .env, manda ese).
ORG_DOMINIO=example.org
# Todos los dominios de correo de la casa. Se suman a /etc/maquita-mail/dominios-propios.txt.
ORG_DOMINIOS="example.org example.com"
# Opcionales. Si no se definen valen todos los dominios propios.
#   Dominios cuyos miembros de un grupo cuentan como internos:
#ORG_DOMINIOS_GRUPOS="example.org"
#   Dominios cuyos enlaces se consideran de casa (no se reescriben ni se retiran):
#ORG_DOMINIOS_ENLACES="example.org"
# Marcas propias que se vigilan contra suplantación: marca=dominio.oficial
#ORG_MARCAS_PROTEGIDAS="miorganizacion=example.org"

# --- Red --------------------------------------------------------------------------------------
# Redes propias en notación CIDR. Un inicio de sesión desde ellas no se trata como de riesgo.
# Las privadas (10/8, 172.16/12, 192.168/16) ya cuentan: aquí van las demás.
ORG_REDES="192.0.2.0/24"

# --- Direcciones ----------------------------------------------------------------------------
ORG_URL_CORREO=https://mail.example.org
ORG_URL_PANEL=https://mail.example.org:8443
#ORG_URL_INTRANET=https://intranet.example.org
#ORG_URL_REUNIONES=https://reuniones.example.org
#ORG_URL_IDENTIDAD=https://auth.example.org
#ORG_REINO_IDENTIDAD=correo
#ORG_URL_CHAT_INTERNO=http://127.0.0.1:8790
#ORG_URL_IA=http://127.0.0.1:11434

# --- Avisos -----------------------------------------------------------------------------------
# A quién avisa el sistema cuando algo falla, y con qué remitente.
ORG_CORREOS_AVISOS="postmaster@example.org"
ORG_REMITENTE_AVISOS=postmaster@example.org
#ORG_REMITENTE_SEGURIDAD=seguridad@example.org
#ORG_REMITENTE_CUMPLIMIENTO="Cumplimiento <cumplimiento@example.org>"
#ORG_REMITENTE_TAREAS="Tareas <tareas@example.org>"
