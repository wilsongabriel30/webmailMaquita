# Radicale (CalDAV/CardDAV) del correo Maquita. Referencia que instala deploy/webmail/instalar.sh.
#
# Modelo de acceso (N-19, 07/09/2026):
# - Radicale escucha SOLO en 127.0.0.1 y confía en la cabecera X-Remote-User (`http_x_remote_user`).
#   La ponen únicamente el backend del correo (con el correo completo de la sesión) y el vhost de
#   nginx para Z-Push (deploy/z-push/nginx/radicale-zpush.conf), que antes valida las credenciales
#   del dispositivo con el backend. Nadie más debe alcanzar este puerto.
# - `rights = owner_only`: cada usuario solo ve /<su correo>/…. El prefijo de las colecciones es el
#   CORREO COMPLETO (el mismo que usa Z-Push con CALDAV_PATH '/%u/').
# - NO usar `auth type = none`: con él cualquier proceso local lee y escribe el calendario de cualquiera.
# - Para Z-Push no se añade la IP del puente de Docker aquí: eso lo hace nginx con auth_request.

[server]
hosts = 127.0.0.1:5232
max_connections = 20
max_content_length = 52428800

[auth]
type = http_x_remote_user

[rights]
type = owner_only

[storage]
filesystem_folder = /var/lib/radicale/collections
type = multifilesystem

[logging]
level = warning
