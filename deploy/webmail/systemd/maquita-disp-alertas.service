[Unit]
Description=Telefonos institucionales: resumen diario y alertas de telemetria (cada 15 min)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/maquita-webmail/backend
EnvironmentFile=/opt/maquita-webmail/backend/.env
Environment=PATH=/opt/maquita-webmail/backend/venv/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/maquita-webmail/backend/venv/bin/python -m app.dispositivos.alertas_tarea
