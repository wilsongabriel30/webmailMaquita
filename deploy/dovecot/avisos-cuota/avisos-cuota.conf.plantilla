# =============================================================================
# Dovecot 2.4 — avisos de cuota del buzón al 95 % y al 85 % (instalado por deploy/dovecot/avisos-cuota/instalar.sh
# en /etc/dovecot/maquita.d/avisos-cuota.conf). @CUOTA@ es el nombre de la cuota del servidor.
# Dovecot ejecuta SOLO el primer aviso que se cumple: el umbral más alto va primero. El aviso salta
# en el momento en que un correo nuevo hace cruzar el umbral (no por buzones que ya estaban encima).
# =============================================================================
quota "@CUOTA@" {
  warning aviso-95 {
    quota_storage_percentage = 95
    execute quota-warning {
      args = 95 %{user}
    }
  }
  warning aviso-85 {
    quota_storage_percentage = 85
    execute quota-warning {
      args = 85 %{user}
    }
  }
}

service quota-warning {
  executable = script /usr/local/bin/maquita-aviso-cuota
  user = vmail
  unix_listener quota-warning {
    user = vmail
  }
}
