# Unidad PLANTILLA para varias instancias del webmail en la misma máquina (opcional).
# La instalación de serie usa maquita-webmail.service (una instancia, 4 workers) y no
# necesita esto. Sirve para actualizar sin corte en UNA máquina: nginx reparte entre
# las instancias y deploy/escala/actualizar-sin-corte.sh las reinicia una a una.
#
#   cp deploy/escala/maquita-webmail@.service /etc/systemd/system/
#   systemctl disable --now maquita-webmail          # la de serie deja de servir
#   systemctl enable --now maquita-webmail@8001 maquita-webmail@8002
#   # nginx: upstream webmail { server 127.0.0.1:8001; server 127.0.0.1:8002; }
#   REPLICAS="local:8001:maquita-webmail@8001:/run/maquita-webmail/drenar-8001 \
#             local:8002:maquita-webmail@8002:/run/maquita-webmail/drenar-8002" \
#     deploy/escala/actualizar-sin-corte.sh
#
# %i = puerto. Las tareas de fondo no se duplican entre instancias (bloqueos en Redis).
[Unit]
Description=Webmail API (instancia %i)
After=network.target postgresql.service redis-server.service dovecot.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/maquita-webmail/backend
Environment=PATH=/opt/maquita-webmail/backend/venv/bin:/usr/local/bin:/usr/bin
EnvironmentFile=/opt/maquita-webmail/backend/.env
Environment=ESCALA_ARCHIVO_DRENAJE=/run/maquita-webmail/drenar-%i
ExecStart=/opt/maquita-webmail/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port %i --workers 2 --loop uvloop
Environment=UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=3
Environment=PYTHONFAULTHANDLER=1
KillMode=mixed
TimeoutStopSec=8
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
