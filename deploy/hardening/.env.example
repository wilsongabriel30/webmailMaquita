# .env.example — configuración del módulo de hardening del correo
# Copiá este archivo y reemplazá los <PLACEHOLDERS> por tus valores.
# Estos son los únicos valores que hay que tocar para adaptar todo el módulo
# (fail2ban action, sync MikroTik, geo-blocking nftables, autoconfig).

# --- MikroTik (bloqueo perimetral) ---
MIKROTIK_HOST=<MIKROTIK_HOST>        # IP del router MikroTik, ej: 192.0.2.1
MT_USER=<MT_USER>                    # usuario dedicado en el router (NO admin), ej: mail-sync
SSH_KEY_PATH=/root/.ssh/mikrotik_sync   # clave SSH privada del usuario dedicado
ADDRESS_LIST=blacklist_mail          # address-list del router que se dropea en raw

# --- Servidor de correo ---
MAIL_DOMAIN=<MAIL_DOMAIN>            # dominio principal, ej: example.org
BLACKLIST_FILE=/etc/mailserver/blacklist-ips.txt   # blacklist curada local

# --- Red / geo-blocking (nftables) ---
LAN_CIDR=<LAN_CIDR>                  # tu red interna, ej: 192.168.1.0/24
PAISES_PERMITIDOS=<PAISES_PERMITIDOS>   # códigos ISO en minúscula, ej: ec es co mx

# Nota: el geo-blocking aplica SOLO a puertos autenticados (443/465/587/143/993/4190);
# el puerto 25 NUNCA se geo-bloquea (se perdería correo legítimo de Gmail/Outlook).
