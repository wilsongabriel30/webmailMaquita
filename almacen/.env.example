# ============================================================================
# Almacén Maquita (Archivos + OnlyOffice del webmail) — configuración
# Copiar a .env y ajustar. El servicio se levanta con deploy/maquita-almacen.service
# ============================================================================

# --- Autenticación (OBLIGATORIO) --------------------------------------------
# EL MISMO SECRET_KEY del backend del webmail (backend/.env → SECRET_KEY).
# Con él se valida la cookie de sesión del webmail.
WEBMAIL_SECRET_KEY=cambiar-por-el-secret-key-del-webmail

# Usuarios administradores del Almacén (separados por coma). Pueden recuperar
# archivos de cualquier persona, ver/editar cuotas y la retención.
ALMACEN_ADMINS=admin@sudominio.org

# Opcional: URL de Redis del webmail para invalidar el acceso al hacer logout
# (si se omite, basta con que el JWT de la cookie no haya expirado).
ALMACEN_REDIS_URL=redis://localhost:6379/0

# Modo del directorio de usuarios:
#  local  (default) = autocontenido: cada buzón que entra se crea solo en la
#          tabla usuarios de la BD del Almacén. Para instalaciones nuevas.
#  nomina = identidad unificada estilo Microsoft 365: el correo del buzón se
#          busca en la columna email de la tabla usuarios de OTRA BD central
#          (NOMINA_DB_*) y se usa ESE id => el mismo almacén y las mismas
#          salas de co-edición en todos los sistemas de la organización.
#ALMACEN_MODO_DIRECTORIO=local
#NOMINA_DB_HOST=
#NOMINA_DB_NAME=
#NOMINA_DB_USER=
#NOMINA_DB_PASSWORD=

# Opcional (fase de pruebas): si se define, SOLO estos correos (más los
# ALMACEN_ADMINS) pueden usar el Almacén. Vacío = todos los buzones.
#ALMACEN_PILOTO=

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Crear antes:  CREATE DATABASE almacen OWNER <usuario>;
# Las tablas se crean solas al arrancar (idempotente).
ALMACEN_DB_HOST=127.0.0.1
ALMACEN_DB_NAME=almacen
ALMACEN_DB_USER=almacen
ALMACEN_DB_PASSWORD=cambiar

# --- Almacenamiento ----------------------------------------------------------
# Carpeta raíz de los archivos (disco local, NAS o NFS montado).
ALMACEN_RAIZ_DATOS=/opt/maquita-webmail/almacen/datos
# Cuota por usuario en bytes (default 20 GB) y tamaño máximo de subida (16 GB)
#ALMACEN_CUOTA_DEFECTO=21474836480
#ALMACEN_MAX_SUBIDA=17179869184
# Días de retención tras vaciar papelera (recuperable solo por admins)
#ALMACEN_RETENCION_DIAS=90

# --- OnlyOffice Document Server (edición colaborativa, opcional) -------------
# Sin esto, todo funciona menos el botón "Editar" (los office se descargan).
# Instalar un DS propio (docker) y usar EL MISMO secreto JWT en ambos lados:
#   docker run -i -t -d --name onlyoffice -p 8080:80 --restart=always \
#     -e JWT_ENABLED=true -e JWT_SECRET=<SECRETO> \
#     -e JWT_HEADER=Authorization -e JWT_IN_BODY=true onlyoffice/documentserver
ALMACEN_ONLYOFFICE_SECRET=
# URL del DS como la ven los NAVEGADORES (mismo dominio del webmail, ver
# deploy/nginx-almacen.conf → bloque /office/)
ALMACEN_ONLYOFFICE_URL_PUBLICA=https://mail.sudominio.org/office
# URL del DS como la ve ESTE SERVIDOR (directa, sin proxy)
ALMACEN_ONLYOFFICE_URL_INTERNA=http://127.0.0.1:8080

# URL pública del sitio (para los enlaces de descarga/callback del DS)
ALMACEN_URL_PUBLICA=https://mail.sudominio.org

# Clave de sesión Flask propia del servicio (cualquier cadena aleatoria larga)
ALMACEN_CLAVE_SESION=cambiar-por-una-cadena-aleatoria

# Contacto que ven los usuarios cuando su buzón aún no está enlazado al
# directorio (mensaje de ayuda "escríbenos y lo activamos"). Vacío = mensaje
# genérico "comunícate con el administrador".
ALMACEN_CONTACTO_SOPORTE=soporte@sudominio.org

# INVITACION_FROM: remitente de las invitaciones a cuentas externas (def: no-reply@<host>)
INVITACION_FROM=
# ACCESS_TOKEN_EXPIRE_MINUTES: vida de la sesion externa (def 480=8h)
