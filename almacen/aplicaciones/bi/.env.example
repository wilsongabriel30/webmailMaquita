# Tableros / BI — Aplicación del Drive Maquita — configuración (sin secretos en el código)
# Secreto compartido con el webmail/Drive: valida el token del usuario (access_token)
WEBMAIL_SECRET_KEY=
# Redis del webmail: valida que la sesión del usuario siga viva
REDIS_URL=redis://127.0.0.1:6379/0
# API interna del Drive Maquita (descargar/listar archivos de datos)
ALMACEN_INTERNAL_URL=http://127.0.0.1:8788
