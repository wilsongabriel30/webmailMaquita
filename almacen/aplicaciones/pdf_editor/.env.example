# Editor de PDF — Aplicación del Drive Maquita — configuración (sin secretos en el código)

# Bases de datos de la app (documentos/anotaciones/firmas) e identidad
HERRAMIENTAS_DATABASE_URI=postgresql://usuario:clave@host:5432/herramientas
AUTH_DATABASE_URI=postgresql://usuario:clave@host:5432/auth

# Secreto compartido con el webmail/Drive: valida el token del usuario (access_token)
WEBMAIL_SECRET_KEY=

# Redis del webmail: valida que la sesión del usuario siga viva
REDIS_URL=redis://127.0.0.1:6379/0

# API interna del Drive Maquita (para leer/guardar los PDF del Drive)
ALMACEN_INTERNAL_URL=http://127.0.0.1:8788

# Portabilidad (C1): rutas de trabajo del editor (se crean si no existen)
PDF_UPLOADS_DIR=/var/lib/maquita-pdf-editor/uploads
PDF_LOGS_DIR=/var/lib/maquita-pdf-editor/logs
