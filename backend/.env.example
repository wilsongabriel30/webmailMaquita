# Fundación Maquita Webmail — Variables de Entorno
# Copiar a .env y editar con tus valores

# Base de datos PostgreSQL
DATABASE_URL=postgresql://mailserver:TU_PASSWORD@localhost:5432/maildb

# Redis (cache y sesiones)
REDIS_URL=redis://:TU_REDIS_PASSWORD@localhost:6379/0

# Clave secreta JWT (generar con: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CAMBIA_ESTO_genera_con_secrets_token_hex

# Servidor de correo (generalmente localhost)
IMAP_HOST=127.0.0.1
IMAP_PORT=143
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SIEVE_HOST=127.0.0.1
SIEVE_PORT=4190

# Tu dominio
MAIL_DOMAIN=tudominio.com
COOKIE_DOMAIN=mail.tudominio.com
CORS_ORIGINS=https://mail.tudominio.com

# Administración
MASTER_PASSWORD=GENERA_PASSWORD_SEGURA
ADMIN_JWT_SECRET=GENERA_OTRO_SECRET

# Opcional: IA (requiere servidor con Ollama)
# IA_API_KEY=tu-clave-api
# OLLAMA_URL=http://ip-servidor-ia:8000

# OnlyOffice Document Server (opcional)
# ONLYOFFICE_URL=http://127.0.0.1:8080

# Ruta de log de seguridad (opcional)
# SECURITY_LOG_PATH=/var/log/webmail/security.log

# Anti-phishing: clasificador externo opcional (vacio = solo heuristica local)
PHISH_CLASSIFIER_URL=
PHISH_CLASSIFIER_KEY=
PHISH_CLASSIFIER_TIMEOUT=4
# Capa externa anti-phishing: KIND=gateway reusa OLLAMA_URL/IA_API_KEY; vacio=modo contrato (PHISH_CLASSIFIER_URL)
PHISH_CLASSIFIER_KIND=
PHISH_CLASSIFIER_MODEL=qwen2.5:7b

# =====================================================# IA enchufable (OPCIONAL) — la app arranca sin IA (fail-open)
# Descomenta UN preset y corre: bash deploy/webmail/probar-ia.sh
# =====================================================# [A] Ollama local (recomendado — servidor INFINITO)
#IA_PROVIDER=ollama
#IA_BASE_URL=http://192.168.2.4:11434
#IA_MODEL=infinito-qwen36-lora:latest
#IA_EMBED_MODEL=nomic-embed-text

# [B] OpenAI
#IA_PROVIDER=openai
#IA_BASE_URL=https://api.openai.com
#IA_MODEL=gpt-4o-mini
#IA_API_KEY=sk-...
#IA_EMBED_MODEL=text-embedding-3-small

# [C] Anthropic
#IA_PROVIDER=anthropic
#IA_BASE_URL=https://api.anthropic.com
#IA_MODEL=claude-3-5-haiku-latest
#IA_API_KEY=sk-ant-...

# [D] Cualquier endpoint OpenAI-compatible (vLLM, LM Studio, OpenRouter, LocalAI...)
#IA_PROVIDER=openai
#IA_BASE_URL=http://tu-endpoint:puerto
#IA_MODEL=tu-modelo
#IA_API_KEY=tu-clave-si-aplica
#IA_TIMEOUT=60

# Rate limiting por usuario (peticiones/minuto). 0 = deshabilitar el tier.
#RATE_LIMIT_READ_PER_MIN=300
#RATE_LIMIT_WRITE_PER_MIN=60
#RATE_LIMIT_SEND_PER_MIN=10
# Tamano maximo de adjunto REAL en MB. Fuente unica: deriva nginx + postfix + frontend.
# Aplicar tras cambiarlo:  deploy/tools/aplicar-limites-tamano.sh
MAX_ATTACHMENT_MB=25

# --- Identidad de la organizacion (para textos de cara al usuario y prompt de IA) ---
# ORG_NAME: nombre de tu organizacion (fallback si no hay branding_settings.org_name).
ORG_NAME=Tu organización
# AI_ORG_CONTEXT: contexto/identidad institucional para el asistente de correo (frase libre).
# Si se deja vacio, la IA usa una identidad neutra con ORG_NAME (no atribuye a otra org).
AI_ORG_CONTEXT=
